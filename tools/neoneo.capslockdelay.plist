<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sets the Caps Lock delay of Karabiner's virtual keyboard to 0.
  macOS delays Caps Lock on Apple-vendor keyboards; the virtual keyboard
  reports Apple's vendor id, so without this a fast Mod3+key types the
  layer-1 character. The setting is lost when Karabiner restarts, so the
  agent sets it at login and again every 30 seconds (idempotent, one
  hidutil call).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>neoneo.capslockdelay</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/hidutil</string>
		<string>property</string>
		<string>--matching</string>
		<string>{"ProductID":0x250,"VendorID":0x5ac}</string>
		<string>--set</string>
		<string>{"CapsLockDelayOverride":0}</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
</dict>
</plist>
