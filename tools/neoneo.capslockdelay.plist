<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Starts neoneo-capslockdelay whenever Karabiner's virtual keyboard appears
  (at login, on Karabiner restarts and updates); the helper turns off the
  Caps Lock delay for it and exits. No polling.
  install.sh replaces __HELPER__ with the helper's absolute path.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>neoneo.capslockdelay</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HELPER__</string>
	</array>
	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.iokit.matching</key>
		<dict>
			<key>karabiner-virtual-keyboard</key>
			<dict>
				<key>IOProviderClass</key>
				<string>IOHIDDevice</string>
				<key>VendorID</key>
				<integer>1452</integer>
				<key>ProductID</key>
				<integer>592</integer>
				<key>IOMatchLaunchStream</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
